GEMINI_API_KEY=your-key-here

# Optional: switch the AI provider that powers scanning/chat/schedule generation.
# Defaults to "gemini". Set to "grok" to use xAI's API instead (e.g. if you've hit
# Gemini's free-tier daily quota) — requires GROK_API_KEY below.
# AI_PROVIDER=grok
# GROK_API_KEY=your-grok-key-here

# Optional: enable WhatsApp medication reminders via Twilio
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
